{{- /* chezmoi:modify-template */ -}}
{{- $existing := .chezmoi.stdin | default "{}" | fromJsonc -}}

{{- $settings := dict
  "profiles" (dict
    "defaults" (dict
        "font" (dict
          "face" "JetBrains Mono"
          "size" 12
        )
        "colorScheme" "Afterglow"
        "selectionBackground" "#6C99BB"
        "bellStyle" (list "window" "taskbar")
    )
  )
  "schemes" (list
    (dict
      "background" "#212121"
      "black" "#151515"
      "blue" "#6C99BB"
      "brightBlack" "#505050"
      "brightBlue" "#6C99BB"
      "brightCyan" "#7DD6CF"
      "brightGreen" "#7E8E50"
      "brightPurple" "#9F4E85"
      "brightRed" "#AC4142"
      "brightWhite" "#F5F5F5"
      "brightYellow" "#E5B567"
      "cursorColor" "#D0D0D0"
      "cyan" "#7DD6CF"
      "foreground" "#D0D0D0"
      "green" "#7E8E50"
      "name" "Afterglow"
      "purple" "#9F4E85"
      "red" "#AC4142"
      "selectionBackground" "#303030"
      "white" "#D0D0D0"
      "yellow" "#E5B567"
    )
  )
-}}

{{- if eq .chezmoi.hostname "DIETCOKE" -}}
  {{- $_ := $settings
    | setValueAtPath "profiles.defaults.font.face" "Cascadia Code"
    | setValueAtPath "profiles.defaults.font.size" 11.5
  -}}
{{- end -}}

{{- merge $settings $existing | toPrettyJson -}}