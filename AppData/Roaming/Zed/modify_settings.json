{{- /* chezmoi:modify-template */ -}}
{{- $existing := .chezmoi.stdin | default "{}" | fromJsonc -}}

{{- $settings := dict
  "auto_update" false
  "disable_ai" true
  "theme" "Gruvbox Dark"
-}}

{{- if eq .chezmoi.hostname "DIETCOKE" -}}
  {{- $_ := $settings
    | setValueAtPath "buffer_font_family" "Cascadia Code"
  -}}
{{- end -}}

{{- if eq .chezmoi.hostname "MTNDEW" -}}
  {{- $_ := $settings
    | setValueAtPath "buffer_font_family" "JetBrains Mono"
  -}}
{{- end -}}

{{- merge $settings $existing | toPrettyJson -}}